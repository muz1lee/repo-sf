# Copy this file to `.env` or export variables in your shell.
# Do not commit real API keys, service tokens, or private endpoints.

# SAM3D has no confirmed default endpoint in this project.
# Set this only when you have verified the current service registry.
SAM3D_PROCESS_URL=

# Optional VLM / proposal service settings.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=

# Optional inpainting service. The CLI also accepts explicit --inpaint-url args.
RSF_INPAINT_URL=
